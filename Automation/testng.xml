<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Medicart">


	<listeners>
		<listener class-name="medicart.TestListeners" />
	</listeners>

	<test name="Chrome_Login_Profile" parallel="false">
		<parameter name="Browser" value="chrome"></parameter>
		<parameter name="URL" value="https://www.medkart.in/home"></parameter>
		<classes>
			<class name="medicart.Login" />
			<class name="medicart.ProfileEdit" />
		</classes>
	</test> <!--Test -->


	<test name="Edge_Login_Profile" parallel="false">
		<parameter name="Browser" value="edge"></parameter>
		<parameter name="URL" value="https://www.medkart.in/home"></parameter>
		<classes>
			<class name="medicart.Login" />
			<class name="medicart.ProfileEdit" />
		</classes>
	</test> <!--Test -->
</suite> <!--
Suite -->
